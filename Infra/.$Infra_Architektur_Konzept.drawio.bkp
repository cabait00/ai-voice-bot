        <mxCell id="EkIpqa0lRWCONsxsSRhO-132" edge="1" parent="QJVMCspfU_33AnuVPJ_e-688" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;edgeStyle=elbowEdgeStyle;fillColor=#dae8fc;strokeColor=#6c8ebf;startArrow=oval;startFill=0;endFill=1;" target="EkIpqa0lRWCONsxsSRhO-6" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="940" />
              <mxPoint x="626" y="732.27" />
