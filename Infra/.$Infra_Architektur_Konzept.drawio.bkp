        <mxCell id="QJVMCspfU_33AnuVPJ_e-58" parent="QJVMCspfU_33AnuVPJ_e-24" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;dashed=1;" value="Application Insights" vertex="1">
