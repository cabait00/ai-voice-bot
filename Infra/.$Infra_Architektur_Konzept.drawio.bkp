  <diagram id="XzfVjHwk0O3oogMqZOhI" name="Identity and Access">
    <mxGraphModel dx="1562" dy="908" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="VfjsMb3SekGinALJHhQ0-1" value="&lt;p&gt;&lt;strong&gt;Authentication and Authorization:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Use Azure Active Directory (AAD) for role-based access control (RBAC).&lt;/li&gt;&lt;li&gt;Ensure that only authorized users or systems can access the models.&lt;/li&gt;&lt;li&gt;Multi-Factor Authentication (MFA) to enhance security.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Secure API Key Management:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Store API keys and certificates securely in Azure Key Vault and Git Secrets.&lt;/li&gt;&lt;li&gt;Regularly rotate keys to minimize security risks.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Network Security:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Implement Azure Virtual Network (VNet) to isolate communication between components.&lt;/li&gt;&lt;li&gt;Hub and Spoke Architecture to isolate data ressources from access ressources&lt;/li&gt;&lt;li&gt;Use Network Security Groups (NSGs) to restrict access to infrastructure.&lt;/li&gt;&lt;li&gt;Deploy a Web Application Firewall (WAF) for the API Gateway to protect against attacks like SQL injections or cross-site scripting (XSS).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Auditing and Logging:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Enable Azure Monitor and Log Analytics to capture security-related events.&lt;/li&gt;&lt;li&gt;Regularly review access logs to identify unauthorized activities.&lt;/li&gt;&lt;li&gt;Alert on unknown user access.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Data Encryption:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Encrypt data at rest (e.g., in Azure Blob Storage) and in transit (using TLS 1.2+).&lt;/li&gt;&lt;li&gt;Ensure no sensitive data is processed without encryption.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Least Privilege Principle:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Grant permissions based on the principle of least privilege.&lt;/li&gt;&lt;li&gt;Regularly review and adjust user and service account permissions.&lt;/li&gt;&lt;li&gt;organize user access in differen groups representing different roles.&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="560" height="510" as="geometry" />
        </mxCell>
        <mxCell id="VfjsMb3SekGinALJHhQ0-2" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Identity and Access principles&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="310" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
