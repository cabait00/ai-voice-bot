        <mxCell id="QJVMCspfU_33AnuVPJ_e-575" parent="QJVMCspfU_33AnuVPJ_e-520" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;fontSize=12;fontColor=#000000;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="(e.g. k8s.gcr.io&lt;span style=&quot;border-color: var(--border-color); box-sizing: border-box; background-color: rgb(255, 255, 255);&quot; class=&quot;pl-s&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;border-color: var(--border-color); box-sizing: border-box; background-color: rgb(255, 255, 255);&quot; class=&quot;pl-s&quot;&gt;&lt;span style=&quot;border-color: var(--border-color); box-sizing: border-box;&quot; class=&quot;pl-pds&quot;&gt;&quot;&lt;/span&gt;*.docker.io&lt;span style=&quot;border-color: var(--border-color); box-sizing: border-box;&quot; class=&quot;pl-pds&quot;&gt;&quot;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: rgb(255, 255, 255);&quot;&gt;, etc.)&lt;/span&gt;" vertex="1">
